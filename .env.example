# Server
# Provided automatically by Railway in production; used locally as a fallback.
PORT=3000
# Comma-separated list of allowed frontend origins for CORS.
# Falls back to http://localhost:3001 when not set.
CORS_ORIGIN=http://localhost:3001
# Swagger/OpenAPI docs exposure and route.
# Use false in environments where docs should be disabled.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Database
# In production point this at the provider's private network (on Railway,
# postgres.railway.internal) so queries do not cross the public internet.
# Locally that name does not resolve, so use the public proxy URL instead.
DATABASE_URL=postgresql://user:password@localhost:5432/shop
# Set to "true" when connecting to a managed DB that requires SSL
# (e.g. Railway's public Postgres proxy). Leave unset for local/private network.
DATABASE_SSL=false
# Optional, production only: the URL the TypeORM CLI uses for migrations.
# Pre-deploy containers run before the private network resolves, so migrations
# fail there with ENOTFOUND; point this at the public proxy URL. Falls back to
# DATABASE_URL when unset, which is what local development wants.
# MIGRATION_DATABASE_URL=postgresql://user:password@public-proxy:5432/railway

# Auth
JWT_SECRET=change-me
OTP_EXPIRE=300000
REFRESH_EXPIRE_TIME=604800000

# Email (sent via Resend's HTTPS API on port 443).
# SMTP is intentionally not used: many hosts (e.g. Railway) block outbound
# SMTP ports, which causes ETIMEDOUT/Connection timeout errors.
RESEND_API_KEY=<RESEND_API_KEY>
# Use a verified sender/domain from your Resend account.
MAIL_FROM="YourBrand <onboarding@yourdomain.com>"

# TurboSMS (phone OTP sending)
TURBOSMS_API_TOKEN=your-turbosms-api-token
TURBOSMS_SENDER=YourSender
# Optional custom endpoint override:
# TURBOSMS_API_URL=https://api.turbosms.ua/message/send.json

# Cloudinary (product images)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Optional alternative to CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=cloud_name
# CLOUDINARY_API_KEY=api_key
# CLOUDINARY_API_SECRET=api_secret
# Optional folder for product image uploads:
# CLOUDINARY_PRODUCTS_FOLDER=products

# Email queue (BullMQ). When false, emails are sent synchronously without Redis.
EMAIL_QUEUE_ENABLED=false
# Supports redis:// and rediss:// (TLS) URLs, including auth credentials.
REDIS_URL=redis://localhost:6379

# Storefront response cache (Redis). Active whenever REDIS_URL is set; set to
# false to serve the catalog straight from Postgres without dropping REDIS_URL.
# Entries are invalidated on every admin write, so this is safe to leave on.
CACHE_ENABLED=true
