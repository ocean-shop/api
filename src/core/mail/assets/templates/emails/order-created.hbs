<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Замовлення #{{orderNumber}} прийнято</title>
    <style>
      @media only screen and (max-width: 620px) {
        .wrap { width: 100% !important; max-width: 100% !important; }
        .px { padding-left: 20px !important; padding-right: 20px !important; }
        .col { display: block !important; width: 100% !important; padding: 0 0 20px !important; }
        .h1 { font-size: 22px !important; line-height: 28px !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background:#ffffff;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" class="wrap" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">

            <!-- logo -->
            <tr>
              <td class="px" style="padding:0 32px 20px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="34" height="34" align="center" bgcolor="#00685f" style="width:34px;height:34px;border-radius:9px;font-family:Arial, Helvetica, sans-serif;font-size:18px;font-weight:bold;color:#ffffff;">O</td>
                    <td style="padding-left:10px;font-family:Arial, Helvetica, sans-serif;font-size:20px;font-weight:bold;letter-spacing:-0.5px;color:#00473f;">Ocean</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- hero -->
            <tr>
              <td class="card px" bgcolor="#f7fbfa" style="background:#f7fbfa;border-radius:16px 16px 0 0;padding:36px 32px 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td>
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr><td width="52" height="52" align="center" bgcolor="#00685f" style="width:52px;height:52px;border-radius:26px;font-family:Arial, Helvetica, sans-serif;font-size:26px;line-height:52px;color:#ffffff;font-weight:bold;">✓</td></tr>
                      </table>
                    </td>
                  </tr>
                  <tr><td class="h1 ink" style="padding-top:20px;font-family:Arial, Helvetica, sans-serif;font-size:26px;line-height:32px;mso-line-height-rule:exactly;font-weight:bold;color:#111c2d;">Дякуємо, замовлення прийнято</td></tr>
                  <tr><td class="ink" style="padding-top:10px;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:23px;mso-line-height-rule:exactly;color:#3d4947;">{{#if firstName}}{{firstName}}, ми{{else}}Ми{{/if}} вже збираємо ваше замовлення <b style="color:#111c2d;">#{{orderNumber}}</b> від {{orderDate}}. Коли передамо його перевізнику, надішлемо трек-номер окремим листом і SMS.</td></tr>
                </table>
              </td>
            </tr>

            <!-- products -->
            <tr>
              <td class="card px" bgcolor="#ffffff" style="background:#ffffff;padding:8px 32px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr><td colspan="3" style="padding:18px 0 4px;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:16px;letter-spacing:1px;text-transform:uppercase;font-weight:bold;color:#00685f;">Товари в замовленні</td></tr>
                  {{#each items}}
                  <tr>
                    <td width="72" valign="top" style="padding:16px 0;{{#unless @last}}border-bottom:1px solid #e3ede9;{{/unless}}">
                      {{#if imageUrl}}
                      <img src="{{imageUrl}}" width="72" height="72" alt="{{name}}" style="display:block;width:72px;height:72px;border-radius:10px;object-fit:cover;background:#e6f0ec;border:0;">
                      {{else}}
                      <div style="width:72px;height:72px;border-radius:10px;background:#e6f0ec;"></div>
                      {{/if}}
                    </td>
                    <td valign="top" style="padding:16px 0 16px 14px;{{#unless @last}}border-bottom:1px solid #e3ede9;{{/unless}}font-family:Arial, Helvetica, sans-serif;">
                      <div style="font-size:15px;line-height:21px;mso-line-height-rule:exactly;color:#111c2d;font-weight:bold;">{{name}}</div>
                      <div style="font-size:13px;line-height:19px;mso-line-height-rule:exactly;color:#5c6b68;padding-top:3px;">Кількість: {{quantity}}</div>
                    </td>
                    <td width="96" align="right" valign="top" style="padding:16px 0;{{#unless @last}}border-bottom:1px solid #e3ede9;{{/unless}}font-family:Arial, Helvetica, sans-serif;">
                      {{#if oldTotal}}
                      <div style="font-size:12px;line-height:18px;color:#6d7a77;text-decoration:line-through;white-space:nowrap;">{{oldTotal}}</div>
                      {{/if}}
                      <div style="font-size:15px;line-height:21px;color:#111c2d;font-weight:bold;white-space:nowrap;">{{total}}</div>
                    </td>
                  </tr>
                  {{/each}}
                </table>
              </td>
            </tr>

            <!-- totals -->
            <tr>
              <td class="card px" bgcolor="#ffffff" style="background:#ffffff;padding:4px 32px 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f2f8f6" style="background:#f2f8f6;border-radius:12px;">
                  <tr>
                    <td style="padding:16px 18px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td style="padding:5px 0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;mso-line-height-rule:exactly;color:#3d4947;">Товари ({{itemsCount}})</td>
                          <td align="right" style="padding:5px 0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;mso-line-height-rule:exactly;color:#3d4947;white-space:nowrap;">{{subtotal}}</td>
                        </tr>
                        {{#if discount}}
                        <tr>
                          <td style="padding:5px 0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;mso-line-height-rule:exactly;color:#00685f;font-weight:bold;">Знижка</td>
                          <td align="right" style="padding:5px 0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;mso-line-height-rule:exactly;color:#00685f;font-weight:bold;white-space:nowrap;">−{{discount}}</td>
                        </tr>
                        {{/if}}
                        {{#if deliveryCost}}
                        <tr>
                          <td style="padding:5px 0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;mso-line-height-rule:exactly;color:#3d4947;">Доставка · {{shippingMethod}}</td>
                          <td align="right" style="padding:5px 0;font-family:Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;mso-line-height-rule:exactly;color:#3d4947;white-space:nowrap;">{{deliveryCost}}</td>
                        </tr>
                        {{/if}}
                        <tr><td colspan="2" style="padding-top:8px;border-bottom:1px solid #d3e4de;font-size:0;line-height:0;">&nbsp;</td></tr>
                        <tr>
                          <td style="padding-top:14px;font-family:Arial, Helvetica, sans-serif;font-size:16px;line-height:22px;font-weight:bold;color:#111c2d;">Разом</td>
                          <td align="right" style="padding-top:14px;font-family:Arial, Helvetica, sans-serif;font-size:24px;line-height:28px;font-weight:bold;color:#111c2d;white-space:nowrap;">{{total}}</td>
                        </tr>
                        <tr><td colspan="2" style="padding-top:4px;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:19px;color:#5c6b68;">{{paymentLabel}}</td></tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- delivery -->
            <tr>
              <td class="card px" bgcolor="#ffffff" style="background:#ffffff;border-radius:0 0 16px 16px;padding:0 32px 36px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="col" width="50%" valign="top" style="padding-right:12px;font-family:Arial, Helvetica, sans-serif;">
                      <div style="font-size:12px;line-height:16px;letter-spacing:1px;text-transform:uppercase;font-weight:bold;color:#00685f;">Доставка</div>
                      <div style="padding-top:8px;font-size:14px;line-height:21px;color:#111c2d;font-weight:bold;">{{shippingMethod}}</div>
                      <div style="font-size:14px;line-height:21px;color:#3d4947;">{{shippingNumber}}</div>
                    </td>
                    <td class="col" width="50%" valign="top" style="padding-left:12px;font-family:Arial, Helvetica, sans-serif;">
                      <div style="font-size:12px;line-height:16px;letter-spacing:1px;text-transform:uppercase;font-weight:bold;color:#00685f;">Отримувач</div>
                      {{#if recipientName}}
                      <div style="padding-top:8px;font-size:14px;line-height:21px;color:#111c2d;font-weight:bold;">{{recipientName}}</div>
                      {{/if}}
                      {{#if phoneNumber}}
                      <div style="font-size:14px;line-height:21px;color:#3d4947;">{{phoneNumber}}</div>
                      {{/if}}
                      <div style="font-size:14px;line-height:21px;color:#3d4947;">{{email}}</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- footer -->
            <tr>
              <td class="px" style="padding:24px 32px 0;font-family:Arial, Helvetica, sans-serif;font-size:12.5px;line-height:19px;color:#5c6b68;">
                Питання щодо замовлення? Відповідайте на цей лист або телефонуйте <a href="tel:0800300500" style="color:#00685f;">0 800 300 500</a> (безкоштовно, щодня 8:00–21:00).<br><br>
                ТОВ «Оушен Шоп», вул. Велика Васильківська, 100, Київ, 03150.<br>
                Цей лист надіслано, бо ви оформили замовлення на <a href="https://ocean.ua" style="color:#00685f;">ocean.ua</a>. <a href="https://ocean.ua/account/notifications" style="color:#00685f;">Налаштування розсилок</a>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
